rec Param (
    name: str
    value: str
)

fun test_union_without_values() {
    union Position {
        Goalie
        Defender
        Midfielder
        Attacker
    }

    assert json([Position::Goalie, Position::Attacker]) == """["Goalie","Attacker"]"""

    json_data = json([Position::Goalie, Position::Attacker])

    # Workaround for not having ::parse on list
    rec Box([Position])
    (parsed) = Box::parse(json_data)!
    assert parsed == [Position::Goalie, Position::Attacker]
}

fun test_json_union_default() {
    union Message {
        Request ( id: str, method: str, params: [Param] )
        Response ( id: str, result: str )
    }

    original = Message::Request (
        id: "..."
        method: "GET"
        params: []
    )

    json_data = json(original)
    println(json_data) # Can't assert because unpredictable attribute ordering

    parsed = Message::parse(json_data)!

    assert parsed == original
    assert "$parsed" == "Request(id: ..., method: GET, params: [])"
}

fun test_mixed_with_and_without_params() {
    union Country {
        Spain
        France
        Italy
    }

    union City {
        Paris
        London
        Madrid
    }

    union VacationPlan {
        StayAtHome
        TravelTo(Country, City)
    }

    original = [
        VacationPlan::StayAtHome
        VacationPlan::TravelTo(Country::France, City::Paris)
    ]

    json_data = json(original)

    # Should serialize to:
    # {"0":["StayAtHome",{"TravelTo":{"0":"France","1":"Paris"}}]}
    # Can't assert because unpredictable attribute ordering
    println(json_data)

    # Workaround for not having ::parse on list/union
    rec Box([VacationPlan])
    (parsed) = Box::parse(json_data)!

    assert parsed == original
}

fun test_json_union_untagged() {
    union IPAddr {
        IPv4 ( int, int, int, int )
        IPv6 ( str )
    } @json("untagged")

    original = [
        IPAddr::IPv4 ( 192, 168, 125, 100 )
        IPAddr::IPv6 ( "fx03....ff" )
    ]

    json_data = json(original)
    println(json_data) # Can't assert because unpredictable attribute ordering

    assert json_data == """[[192,168,125,100],"fx03....ff"]"""

    # Workaround for not having ::parse on list yet
    rec Box([IPAddr])
    (parsed) = Box::parse(json_data)!

    assert parsed == original
}

fun test_json_union_untagged_single() {
    union Option {
        None
        Some(str)
    } @json("untagged")

    assert json([Option::None]) == "[null]"
    assert json([Option::Some("foo")]) == """["foo"]"""

    assert Option::parse("null".as_json())! == Option::None
    assert Option::parse(""" "foo" """.as_json())! == Option::Some("foo")
}

fun test_json_union_untagged_named() {
    union Color {
        RGB ( r: int, g: int, b: int )
        HSV ( h: int, s: int, v: int )
    } @json("untagged")

    input = """{"r": 64, "g": 128, "b": 192}""".as_json()
    assert Color::parse(input)! == Color::RGB(r: 64, g: 128, b: 192)

    input = """{"h": 64, "s": 255, "v": 128}""".as_json()
    assert Color::parse(input)! == Color::HSV ( h: 64, s: 255, v: 128 )

    original = [
        Color::RGB ( r: 128, g: 128, b: 32 )
        Color::HSV ( h: 64, s: 255, v: 128 )
    ]

    json_data = json(original)
    println(json_data) # Can't assert because unpredictable attribute ordering

    # Workaround for not having ::parse on list yet
    rec Box([Color])
    (parsed) = Box::parse(json_data)!

    assert parsed == original

}
