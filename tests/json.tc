fun test_pascal_casing() {
    rec Test(
        snake_case: int
        camelCase: int
        PascalCase: int
    ) @json(casing: "pascal")

    city = Test(1, 2, 3)

    assert json(city).contains(""""SnakeCase":1""")
    assert json(city).contains(""""CamelCase":2""")
    assert json(city).contains(""""PascalCase":3""")

    back = Test::parse(json(city))!
    assert back.snake_case == 1
    assert back.camelCase == 2
    assert back.PascalCase == 3
}

