
fun test_simple_serialization() {
    rec Foo(x: int)

    assert json(Foo(13)) == """{"x":13}"""
}

fun test_unnamed_values() {
    rec IPv4(int, int, int, int)

    orig = IPv4(192, 168, 125, 100)

    json_data = json(orig)
    assert json_data == """[192,168,125,100]"""

    parsed = IPv4::parse(json_data)!
    assert parsed == orig
}

fun test_mixed_values() {
    rec Coord(int, int, unit: str)

    orig = Coord(100, 200, unit: "meter")

    json_data = json(orig)
    assert json_data.contains(""""0":100""")
    assert json_data.contains(""""1":200""")

    parsed = Coord::parse(json_data)!
    assert parsed == orig
}

fun test_serialization_with_attrs() {
    rec Foo(
        x: int @json(name: "taco")
    )

    assert json(Foo(x: 13)) == """{"taco":13}"""
}

fun test_serialization_in_callback() {
    rec Foo(
        x: int @json(name: "taco")
    )

    points = [Foo(2), Foo(4)]

    assert points.map(fun(p) { json(p) }) == ["""{"taco":2}""", """{"taco":4}"""]
}

fun test_parse_json() {
    input = """{ "a": 123, "b": 456 }""".as_json()

    rec Point(a: int, b: int)
    res = Point::parse(input)

    assert res.is_ok()

    p = res.value()!
    assert "$p" == "Point(a: 123, b: 456)"
}

fun test_parse_array() {
    input = """[1, 2, 3]""".as_json()

    # The way to parse a JSON array is to define a rec with a single list member
    rec List([int])

    (items) = List::parse(input)!

    assert items == [1, 2, 3]
}

fun test_parse_json_with_attrs() {
    input = """{ "foo": 123, "bar": 456 }""".as_json()

    rec Point(
        a: int @json(name: "foo")
        b: int @json(name: "bar")
    )
    res = Point::parse(input)

    assert res.is_ok()

    p = res.value()!
    assert "$p" == "Point(a: 123, b: 456)"
}

fun test_parse_invalid_json_error() {
    rec Point(a: int, b: int)

    input = """{ poop }""".as_json()
    res = Point::parse(input)

    assert res.is_err()
    assert res.error().is_some()
    assert res.value().is_none()

    err = res.error()!
    assert typeof(err) == "ParseError(message: str)"
    assert err.message.contains("Invalid character")
}

fun test_kebab_casing() {
    rec Test(
        snake_case: int
        camelCase: int
        PascalCase: int
    ) @json(casing: "kebab")

    city = Test(1, 2, 3)

    assert json(city).contains(""""snake-case":1""")
    assert json(city).contains(""""camel-case":2""")
    assert json(city).contains(""""pascal-case":3""")

    back = Test::parse(json(city))!
    assert back.snake_case == 1
    assert back.camelCase == 2
    assert back.PascalCase == 3
}

